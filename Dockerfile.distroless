# Docker image definition

# first stage builds Vue frontend
# node 22 or newer: the pnpm version pinned in frontend/package.json needs the
# newer corepack, node 18 is end of life since April 2025.
FROM node:24 AS vue-build

ARG TARGETARCH

WORKDIR /build
COPY ./frontend .

# pnpm version is pinned in frontend/package.json ("packageManager"), so that exact
# release is activated via corepack instead of installing "latest" globally.
# COREPACK_ENABLE_DOWNLOAD_PROMPT keeps corepack non-interactive while fetching it.
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable pnpm && \
  pnpm install --frozen-lockfile && \
  pnpm run build

# second stage builds Go backend
FROM golang:1.24-bookworm AS go-build

WORKDIR /go/src/app

COPY ./config /go/src/app/config
COPY ./*txt .
COPY ./*go .
COPY ./go.* .

RUN go mod tidy && \
  mkdir -p /empty/config && \
  mkdir -p /empty/dist && \
  CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -o /casavue .

# final image
FROM gcr.io/distroless/static-debian12:nonroot

USER nonroot:nonroot

WORKDIR /app

COPY --chown=nonroot:nonroot --from=go-build /casavue /app/
COPY --chown=nonroot:nonroot --from=go-build /empty/config /app/config
COPY --chown=nonroot:nonroot --from=go-build /empty/dist /app/dist
COPY --chown=nonroot:nonroot --from=vue-build /build/dist /app/frontend/dist/
COPY --chown=nonroot:nonroot --from=vue-build /build/src/assets /app/frontend/src/assets

ENTRYPOINT ["./casavue"]
